# Docker: MySQL + phpMyAdmin.
# Copiá este archivo a .env y poné tus propias contraseñas antes de levantar nada.
#   cp .env.example .env

DB_ROOT_PASSWORD=cambiame
DB_NAME=resto
DB_USER=resto
DB_PASSWORD=cambiame

# Puertos propios, para no chocar con otro MySQL que ya tengas corriendo.
DB_PORT=3308
PMA_PORT=8082

# La base corre en la hora del local, no en UTC: los reportes agrupan por
# DATE() y HOUR(), y una "hora pico" calculada en UTC está corrida.
TZ=America/Argentina/Buenos_Aires
DB_TIMEZONE=-03:00
